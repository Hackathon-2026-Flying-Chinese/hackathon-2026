+"""Invoice endpoints for the customer portal: the list, and the PDF of one invoice."""
+from decimal import Decimal
+
+from fastapi import APIRouter, Depends, HTTPException
+
+from auth import User, current_user
+from db import db
+from models import Invoice
+from pdf import render_pdf
+
+router = APIRouter()
+CENTS = Decimal("0.01")  # amounts are exact decimals, never floats
+
+
+@router.get("/invoices")
+def list_invoices(customer_id: int, user: User = Depends(current_user)):
+    rows = db.execute(
+        "SELECT id, amount, status FROM invoices WHERE customer_id = :cid",
+        {"cid": customer_id},
+    )
+    return [dict(r) for r in rows]
+
+
+@router.get("/invoices/{invoice_id}/pdf")
+def invoice_pdf(invoice_id: int, user: User = Depends(current_user)):
+    inv = db.get(Invoice, invoice_id)
+    if inv is None or inv.customer_id != user.customer_id:
+        raise HTTPException(status_code=404)
+    return render_pdf(inv)
+
+
+def invoice_total(inv: Invoice) -> Decimal:
+    """The sum of the invoice lines, rounded to cents."""
+    # Each line is already rounded; the sum is rounded again so totals match the PDF.
+    total = sum((line.amount for line in inv.lines), Decimal("0"))
+    return total.quantize(CENTS)
+
+
+def invoice_number(inv: Invoice) -> str:
+    """The number customers see, for example INV-1703."""
+    return f"INV-{inv.id}"
diff --git a/test_invoices.py b/test_invoices.py
new file mode 100644
index 0000000..714689b
--- /dev/null
+++ b/test_invoices.py
@@ -0,0 +1,36 @@
+from decimal import Decimal
+
+
+def test_list_invoices_returns_own(client, login):
+    res = client.get("/invoices?customer_id=42", headers=login(42))
+    assert res.status_code == 200
+    assert len(res.json()) == 2
+
+
+def test_requires_login(client):
+    assert client.get("/invoices?customer_id=42").status_code == 401
+    assert client.get("/invoices/1701/pdf").status_code == 401
+
+
+def test_amounts_are_decimal(client, login):
+    rows = client.get("/invoices?customer_id=42", headers=login(42)).json()
+    assert all(Decimal(r["amount"]).as_tuple().exponent == -2 for r in rows)
+
+
+def test_new_customer_gets_empty_list(client, login):
+    assert client.get("/invoices?customer_id=99", headers=login(99)).json() == []
+
+
+def test_owner_gets_pdf(client, login):
+    res = client.get("/invoices/1701/pdf", headers=login(42))
+    assert res.headers["content-type"] == "application/pdf"
+
+
+def test_other_customer_gets_404(client, login):
+    assert client.get("/invoices/1703/pdf", headers=login(42)).status_code == 404
+
+
+def test_pdf_shows_total(client, login):
+    res = client.get("/invoices/1701/pdf", headers=login(42))
+    assert res.status_code == 200
+    assert b"AUD 410.00" in res.content
